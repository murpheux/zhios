# 1Password REFERENCES only (op://vault/item/field) - no secret values. Consumed by:
#   op run --env-file=yone.op.env -- npm run dev -w yone
# Item layout is documented in yone/README.md. Remove any line whose channel you don't use;
# an unset channel simply answers 503 CHANNEL_NOT_CONFIGURED.
ALLOWED_SERVICE_TOKENS=op://zuma/yone-gateway/service_tokens
SENDGRID_API_KEY=op://zuma/yone-email-gateway/api_key
EMAIL_FROM_ADDRESS=op://zuma/yone-email-gateway/from_address
TWILIO_ACCOUNT_SID=op://zuma/yone-sms-gateway/account_sid
TWILIO_AUTH_TOKEN=op://zuma/yone-sms-gateway/auth_token
TWILIO_MESSAGING_SERVICE_SID=op://zuma/yone-sms-gateway/messaging_service_sid
SLACK_WEBHOOK_URLS=op://zuma/yone-slack/webhook_urls
TEAMS_WEBHOOK_URLS=op://zuma/yone-teams/webhook_urls
