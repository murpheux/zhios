<mxfile host="app.diagrams.net" agent="zhios-architect" version="24.7.17" type="device"><diagram id="1-logical-architecture" name="1 Logical Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 l1" value='zhios — Logical Architecture (target state)&lt;br&gt;&lt;span style="font-size:12px;font-weight:normal"&gt;gnee clients · zuma wallet/transaction platform · ozzo auth &amp;amp; accounts · yone notifications. Solid border = exists in repo today; dashed + [NEW] = recommended addition.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1900" height="60" as="geometry"/></mxCell><mxCell id="1 l2" value="1 · Clients" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;horizontal=0;verticalAlign=top;align=center;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1560" height="150" as="geometry"/></mxCell><mxCell id="1 l3" value="2 · Edge &amp;amp; API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;horizontal=0;verticalAlign=top;align=center;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="1560" height="220" as="geometry"/></mxCell><mxCell id="1 l4" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;East-west firewall&lt;/b&gt; — Istio ambient mesh, mTLS STRICT (SPIFFE IDs)&lt;br&gt;AuthorizationPolicy + NetworkPolicy default-deny · SGs for Pods on data paths&lt;br&gt;every service re-verifies the user JWT (defence in depth)' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="1560" height="52" as="geometry"/></mxCell><mxCell id="1 l5" value="3 · Services" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;horizontal=0;verticalAlign=top;align=center;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="1560" height="370" as="geometry"/></mxCell><mxCell id="1 l6" value="4 · Messaging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;horizontal=0;verticalAlign=top;align=center;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1560" height="135" as="geometry"/></mxCell><mxCell id="1 l7" value="5 · Data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;horizontal=0;verticalAlign=top;align=center;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1560" height="180" as="geometry"/></mxCell><mxCell id="1 l8" value='&lt;b&gt;gnee iOS app&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;React Native · Expo SDK 58&lt;br&gt;EAS Build → App Store&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="130" width="200" height="85" as="geometry"/></mxCell><mxCell id="1 l9" value='&lt;b&gt;gnee Android app&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;React Native · Expo SDK 58&lt;br&gt;EAS Build → Play Store&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="200" height="85" as="geometry"/></mxCell><mxCell id="1 l10" value='&lt;b&gt;gnee Web SPA&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;React 19 + Vite&lt;br&gt;static build on S3 + CloudFront&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="200" height="85" as="geometry"/></mxCell><mxCell id="1 l11" value='&lt;b&gt;packages/api-client (shared)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;GraphQL client · sats helpers · send validation · one Idempotency-Key per review session · OIDC Auth Code + PKCE · &lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;persisted-query hashes&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="360" height="85" as="geometry"/></mxCell><mxCell id="1 l12" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Route 53&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;public zone · DNSSEC · alias → CloudFront · health-check failover&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="295" width="130" height="90" as="geometry"/></mxCell><mxCell id="1 l13" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;CloudFront CDN&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;TLSv1.2_2021+ · HTTP/2+3 · WSS · VPC origin → internal ALB&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="295" width="180" height="90" as="geometry"/></mxCell><mxCell id="1 l14" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;S3 SPA bucket&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;private · OAC only · versioned&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="395" width="180" height="55" as="geometry"/></mxCell><mxCell id="1 l15" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Public firewall: AWS WAF + Shield Std&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;IP reputation · CRS · KnownBadInputs · rate 2000 req/5 min/IP · body ≤ 64 KB · geo allowlist (CA/US)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="295" width="240" height="90" as="geometry"/></mxCell><mxCell id="1 l16" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Internal ALB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;HTTPS 443 · ACM · TLS13-1-2 policy · private subnets · TG → /readyz&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="295" width="170" height="90" as="geometry"/></mxCell><mxCell id="1 l17" value='&lt;b&gt;API Gateway — graphql-gateway (zuma/graphql) :3003&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Fastify + Mercurius · Okta JWT verify (JWKS) · CORS allowlist · depth limit · timeouts · rate limit · DataLoader&lt;br&gt;&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;query cost limit · trusted/persisted queries only in prod · introspection off · ozzo composition · WS subscriptions (tx status)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="960" y="290" width="400" height="120" as="geometry"/></mxCell><mxCell id="1 l18" value='&lt;span style="font-size:10px"&gt;&lt;b&gt;Single entry point:&lt;/b&gt; only the gateway is an ALB target. wallet, transaction, ozzo and yone have no Ingress and are reachable only east-west.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="400" width="460" height="50" as="geometry"/></mxCell><mxCell id="1 l19" value="zuma (ns zuma)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;strokeWidth=2;strokeColor=#82b366;fillColor=none;fontColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="640" height="320" as="geometry"/></mxCell><mxCell id="1 l20" value='&lt;b&gt;wallet-service :3001&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;wallets · balances (int sats) · idempotent ledger · guarded atomic debit · /internal/wallets/:id/{debits,credits}&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="250" height="120" as="geometry"/></mxCell><mxCell id="1 l21" value='&lt;b&gt;transaction-service :3002&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;create · validate · broadcast · status · Idempotency-Key dedupe · pending → broadcasting → broadcast → confirmed | failed (refund)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="630" width="250" height="120" as="geometry"/></mxCell><mxCell id="1 l22" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;outbox relay&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;change stream on outbox → SNS · leader-elected&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="170" y="790" width="160" height="60" as="geometry"/></mxCell><mxCell id="1 l23" value='&lt;b&gt;Bitcoin node adapter&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Mock today → Bitcoin Core RPC / provider (egress allowlisted); signing via KMS secp256k1 / CloudHSM&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="790" width="250" height="80" as="geometry"/></mxCell><mxCell id="1 l24" value="ozzo · auth &amp;amp; accounts" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;strokeWidth=2;strokeColor=#82b366;fillColor=none;fontColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="420" height="320" as="geometry"/></mxCell><mxCell id="1 l25" value='&lt;b&gt;ozzo-service :3004&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;user management (Okta subjects) · bank accounts · wallet sync from zuma (Redis read-through, TTL 300 s) · Prisma · OpenAPI /docs&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="630" width="380" height="120" as="geometry"/></mxCell><mxCell id="1 l26" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;wallet-events consumer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;SQS → invalidate / refresh wallet cache&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="790" width="320" height="60" as="geometry"/></mxCell><mxCell id="1 l27" value="yone · notifications (stateless)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;strokeWidth=2;strokeColor=#82b366;fillColor=none;fontColor=#82b366;dashed=0;" vertex="1" parent="1"><mxGeometry x="1160" y="590" width="420" height="320" as="geometry"/></mxCell><mxCell id="1 l28" value='&lt;b&gt;yone-api :3005&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;email (SendGrid) · SMS (Twilio) · Slack / Teams webhooks · named targets only · host pinning · no redirects · moved off 3004 (clash with ozzo)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="630" width="380" height="120" as="geometry"/></mxCell><mxCell id="1 l29" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;notification worker&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;SQS long-poll · KEDA 1–10 · dedupe Redis SET NX notif:{eventId}:{channel} · per-provider circuit breaker&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="790" width="380" height="75" as="geometry"/></mxCell><mxCell id="1 l30" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;SNS zhios-domain-events&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;SSE-KMS · filter policies · tx.* wallet.* user.*&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="975" width="260" height="75" as="geometry"/></mxCell><mxCell id="1 l31" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;SQS ozzo-wallet-sync + DLQ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;filter wallet.* · maxReceive 5&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="975" width="320" height="75" as="geometry"/></mxCell><mxCell id="1 l32" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;SQS yone-notifications + DLQ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;filter tx.*, user.* · visibility 60 s · maxReceive 5&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="975" width="320" height="75" as="geometry"/></mxCell><mxCell id="1 l33" value='&lt;b&gt;MongoDB 7 (zuma)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Atlas M30 · 3-node RS over 3 AZs · PrivateLink · TLS · PITR · wallets · ledger · transactions · outbox&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="1125" width="290" height="125" as="geometry"/></mxCell><mxCell id="1 l34" value='&lt;b&gt;Redis cache (shared)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;ElastiCache for Valkey · Multi-AZ · TLS + RBAC · ACL key patterns ozzo:* zuma:* yone:*&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="390" y="1125" width="290" height="125" as="geometry"/></mxCell><mxCell id="1 l35" value='&lt;b&gt;PostgreSQL 16 (ozzo)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;RDS Multi-AZ · KMS CMK · users · bank_accounts · account numbers column-encrypted · RDS Proxy&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSi