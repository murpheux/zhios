            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation CreateWallet($input: CreateWalletInput!) { createWallet(input: $input) { id label address network type balanceCache status createdAt updatedAt } }\",\n  \"variables\": { \"input\": { \"label\": \"My Hot Wallet\", \"network\": \"testnet\", \"type\": \"hot\", \"ownerUserId\": \"user-123\", \"metadata\": { \"purpose\": \"payroll\" } } }\n}"
            },
            "url": {
              "raw": "{{graphqlBaseUrl}}/graphql",
              "host": ["{{graphqlBaseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Create a new wallet via the gateway."
          }
        },
