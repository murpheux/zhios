    {
      "name": "GraphQL Gateway",
      "item": [
        {
          "name": "Query: wallet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query Wallet($id: ID!) { wallet(id: $id) { id label address network type balanceCache metadata ownerUserId status createdAt updatedAt } }\",\n  \"variables\": { \"id\": \"{{walletId}}\" }\n}"
            },
            "url": {
              "raw": "{{graphqlBaseUrl}}/graphql",
              "host": ["{{graphqlBaseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Fetch a single wallet by id."
          }
        },
        {
          "name": "Query: wallets (paginated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query Wallets($page: Int, $limit: Int, $ownerUserId: String) { wallets(page: $page, limit: $limit, ownerUserId: $ownerUserId) { items { id label network type balanceCache status } pageInfo { total page limit totalPages } } }\",\n  \"variables\": { \"page\": 1, \"limit\": 20, \"ownerUserId\": \"user-123\" }\n}"
            },
            "url": {
              "raw": "{{graphqlBaseUrl}}/graphql",
              "host": ["{{graphqlBaseUrl}}"],
              "path": ["graphql"]
            },
            "description": "List wallets with pagination."
          }
        },
