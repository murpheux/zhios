# @gnee/api-client reads no environment itself. Telemetry is wired by the host app:
# it calls setErrorReporter() with a New Relic adapter at startup (see
# apps/web/spa/src/utils/newrelic.ts and packages/mobile-ui/src/utils/newrelic.ts).
# Configure New Relic in the apps instead:
#   web:    apps/web/spa/env.example   (VITE_NEWRELIC_*)
#   mobile: apps/ios/env.example, apps/android/env.example (EXPO_PUBLIC_NEWRELIC_*)
