{
  "name": "zuma",
  "private": true,
  "version": "0.1.0",
  "description": "Zuma - Bitcoin wallet & transaction microservices platform",
  "workspaces": [
    "shared/*",
    "services/*",
    "graphql"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "test": "npm run build --silent && npm test --workspaces --if-present",
    "dev:wallet": "npm run dev -w @zuma/wallet-service",
    "dev:transaction": "npm run dev -w @zuma/transaction-service",
    "dev:graphql": "npm run dev -w @zuma/graphql-gateway"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1"
  }
}
