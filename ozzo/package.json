{
  "name": "ozzo",
  "version": "0.1.0",
  "private": true,
  "description": "Subscription account management microservice (users, bank accounts, wallet sync)",
  "main": "dist/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "biome lint .",
    "test": "jest --selectProjects unit --no-watchman",
    "test:integration": "jest --selectProjects integration --runInBand --no-watchman",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "@prisma/client": "^6.1.0",
    "@scalar/fastify-api-reference": "^1.25.0",
    "axios": "^1.7.9",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "newrelic": "^11.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^10.3.1",
    "pino-roll": "^1.3.0",
    "prisma": "^6.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
