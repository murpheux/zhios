      "name": "Health & Readiness",
      "description": "Liveness and readiness probes for orchestration and monitoring.",
      "item": [
        {
          "name": "GET /healthz",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is {status: ok}', function () { pm.expect(pm.response.json()).to.eql({ status: 'ok' }); });",
                  "pm.test('Probe is not rate limited', function () { pm.expect(pm.response.headers.has('x-ratelimit-limit')).to.be.false; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
