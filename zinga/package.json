{
  "name": "@zhios/zinga",
  "version": "1.0.0",
  "description": "Zinga - Wallet and Ledger Microservice for zhios payment platform",
  "type": "module",
  "main": "dist/app.js",
  "exports": {
    ".": "./dist/app.js"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist/",
    "dev": "node --loader ts-node/esm ./services/wallet-service/src/app.ts",
    "dev:watch": "tsx watch ./services/wallet-service/src/app.ts",
    "start": "node dist/services/wallet-service/src/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --apply .",
    "lint:check": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "tsx ./scripts/migrate.ts",
    "db:seed": "tsx ./scripts/seed.ts",
    "db:reset": "tsx ./scripts/reset.ts",
    "db:verify": "tsx ./scripts/verify-ledger.ts",
    "logs": "tail -f /tmp/zinga.log",
    "docker:build": "docker build -f infrastructure/docker/wallet-service.Dockerfile -t zinga/wallet-service:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local zinga/wallet-service:latest"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.690.0",
    "@aws-sdk/client-ssm": "^3.690.0",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.49.1",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-node": "^0.49.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@types/node": "^22.10.2",
    "dotenv": "^16.3.1",
    "fastify": "^5.2.0",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.11.3",
    "pino": "^9.6.0",
    "pino-pretty": "^10.3.1",
    "pino-roll": "^2.0.0",
    "prom-client": "^15.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.13",
    "@types/pg": "^8.11.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
