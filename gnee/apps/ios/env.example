EXPO_PUBLIC_ZUMA_GATEWAY_URL=http://localhost:3003/graphql

# New Relic Mobile (one.newrelic.com -> Add data -> Mobile monitoring; use the *mobile application token*,
# one app per platform). EXPO_PUBLIC_* values are bundled into the JS, so the token is not a secret,
# but keep it out of git: set it per build as an EAS environment variable.
EXPO_PUBLIC_NEWRELIC_ENABLED=false
EXPO_PUBLIC_NEWRELIC_APP_TOKEN=
EXPO_PUBLIC_APP_ENV=development
