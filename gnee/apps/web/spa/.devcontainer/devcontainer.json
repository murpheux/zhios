{
  "name": "gnee/web-spa",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bullseye",
  "workspaceFolder": "/workspace/gnee",
  "workspaceMount": "source=${localWorkspaceFolder}/../../..,target=/workspace/gnee,type=bind,consistency=cached",
  "postCreateCommand": "npm install && npx playwright install --with-deps chromium",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "ms-playwright.playwright"]
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development"
  }
}
