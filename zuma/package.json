{
  "name": "zuma",
  "private": true,
  "version": "0.1.0",
  "description": "Zuma - Bitcoin wallet & transaction microservices platform",
  "workspaces": [
    "shared/*",
    "services/*",
    "graphql"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.js",
    "clean": "tsc -b tsconfig.json --clean && rimraf dist/",
    "lint": "biome lint .",
    "typecheck": "tsc -b tsconfig.json",
    "test": "npm run build --silent && npm test --workspaces --if-present",
    "test:unit": "npm test --workspaces --if-present -- --testPathIgnorePatterns repository",
    "test:integration": "npm test --workspaces --if-present -- --testPathPattern repository",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "dev:wallet": "npm run dev -w @zuma/wallet-service",
    "dev:transaction": "npm run dev -w @zuma/transaction-service",
    "dev:graphql": "npm run dev -w @zuma/graphql-gateway",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1",
    "@biomejs/biome": "^2.2.0",
    "esbuild": "^0.24.0"
  }
}
