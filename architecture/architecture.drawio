ometry"/></mxCell><mxCell id="2 p42" value='&lt;b&gt;ns zuma&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;graphql-gateway ×3 (Argo Rollout, blue/green) · wallet-service ×3 · transaction-service ×3 · outbox-relay ×2 [NEW]&lt;br&gt;HPA min 3 · PDB minAvailable 2 · topologySpread by zone&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="130" y="720" width="330" height="125" as="geometry"/></mxCell><mxCell id="2 p43" value='&lt;b&gt;ns ozzo&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;ozzo-service ×3 · wallet-events consumer ×2 [NEW]&lt;br&gt;HPA min 3 max 10 · SG for Pods → RDS Proxy&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="475" y="720" width="320" height="125" as="geometry"/></mxCell><mxCell id="2 p44" value='&lt;b&gt;ns yone&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;yone-api ×2 · notification worker 1–10 (KEDA on SQS depth) [NEW]&lt;br&gt;Internet egress only via Network Firewall&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="720" width="320" height="125" as="geometry"/></mxCell><mxCell id="2 p45" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;ns istio-system&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;istiod ×2 · ztunnel DaemonSet (L4 mTLS) · waypoints for zuma/ozzo (L7 retries, timeouts, outlier detection)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="860" width="330" height="110" as="geometry"/></mxCell><mxCell id="2 p46" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b