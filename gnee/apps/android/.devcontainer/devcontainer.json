{
  "name": "gnee/android",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bullseye",
  "workspaceFolder": "/workspace/gnee",
  "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspace/gnee,type=bind,consistency=cached",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17" },
    "ghcr.io/devcontainers-community/features/android-sdk:0": { "platformVersion": "34", "buildToolsVersion": "34.0.0" }
  },
  "postCreateCommand": "npm install",
  "forwardPorts": [8081, 19000, 19001, 19002],
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "msjsdiag.vscode-react-native"]
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development",
    "ANDROID_HOME": "/opt/android-sdk"
  }
}
