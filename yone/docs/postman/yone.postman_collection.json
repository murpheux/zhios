{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "yone Notification Service",
    "description": "Service-to-service notification gateway: email, SMS, Slack, Teams.\n\nAll notification endpoints require x-service-token authentication. The collection's pre-request script mints service tokens (HS256) signed with internalJwtSecret. See environment variables below.\n\nRun requests in order or individually; the collection stores tokens and generated IDs in collection variables for chaining.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// yone collection pre-request: mints/refreshes service token before requests that need authentication.",
          "// Variables come from the environment; tokens go to collection variables.",
          "const cv = pm.collectionVariables;",
          "const v = function (k, d) {",
          "  const x = pm.variables.get(k);",
          "  return x === undefined || x === null || x === '' ? (d === undefined ? '' : d) : String(x);",
          "};",
          "const now = Math.floor(Date.now() / 1000);",
          "const ttl = Math.min(Math.max(parseInt(v('internalJwtTtlSeconds', '300'), 10) || 300, 30), 3600);",
          "",
          "const b64url = function (wordArray) {",
          "  return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "};",
          "const segment = function (obj) { return b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj))); };",
          "const signHs256 = function (claims, secret, header) {",
          "  const input = segment(header || { alg: 'HS256', typ: 'JWT' }) + '.' + segment(claims);",
          "  return input + '.' + b64url(CryptoJS.HmacSHA256(input, secret));",
          "};",
          "",
          "const internalJwtSecret = v('internalJwtSecret');",
          "if (!internalJwtSecret) {",
          "  console.warn('[yone] internalJwtSecret is empty: service tokens not minted (requests will get 401)');",
          "} else {",
          "  const serviceTokenClaims = {",
          "    sub: v('serviceTokenSub', 'wallet-service'),",
          "    aud: v('serviceTokenAudience', 'yone'),",
          "    role: 'service',",
          "    iss: v('internalJwtIssuer', 'zhios'),",
          "    iat: now,",
          "    exp: now + ttl",
          "  };",
          "  cv.set('serviceToken', signHs256(serviceTokenClaims, internalJwtSecret));",
          "  cv.set('serviceTokenExp', now + ttl);",
          "}"
        ]
      }
    }
  ],
