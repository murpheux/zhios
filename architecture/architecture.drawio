tml=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1600" width="300" height="26" as="geometry"/></mxCell><mxCell id="2 p116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;dashPattern=10 3 2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1651" as="sourcePoint"/><mxPoint x="900" y="1651" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2 p117" value="AuthN: OIDC / JWKS / token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1638" width="300" height="26" as="geometry"/></mxCell><mxCell id="2 p118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#0e8088;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1575" as="sourcePoint"/><mxPoint x="1290" y="1575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2 p119" value="Telemetry: OTLP traces, metrics, logs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1562" width="300" height="26" as="geometry"/></mxCell><mxCell id="2 p120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;dashed=1;dashPattern=4 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1613" as="sourcePoint"/><mxPoint x="1290" y="1613" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2 p121" value="Egress to Internet SaaS (via egress firewall)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1600" width="300" height="26" as="geometry"/></mxCell><mxCell id="2 p122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#996185;dashed=1;dashPattern=1 2;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1651" as="sourcePoint"/><mxPoint x="1290" y="1651" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2 p123" value="Replication / backup / DR copy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1638" width="300" height="26" as="geometry"/></mxCell><mxCell id="2 p124" value='&lt;span style="font-size:10px"&gt;Numbers ①–⑨ trace the primary "send bitcoin" flow. Ports: gateway 3003 · wallet 3001 · transaction 3002 · ozzo 3004 · yone 3005 (moved from 3004) · Mongo 27017 · Postgres 5432 · Redis 6379 · OTLP 4317/4318.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="1670" width="1530" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3-network-security" name="3 Network Security"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 n1" value='zhios — Network Topology &amp;amp; Firewall Rules (defence in depth)&lt;br&gt;&lt;span style="font-size:12px;font-weight:normal"&gt;Default deny at every layer. North-south: L1 edge → L2 perimeter → L3 gateway. East-west: L4 mesh. Data: L5. Egress: L6.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2100" height="60" as="geometry"/></mxCell><mxCell id="3 n2" value='&lt;b&gt;Internet clients&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;iOS · Android · browsers&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n3" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;L1 Edge firewall&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Route 53 (DNSSEC) → CloudFront → AWS WAF WebACL + Shield Std&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="305" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n4" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;L2 Perimeter&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;internal ALB in private subnet · sg-alb inbound only from CloudFront VPC-origin SG&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n5" value='&lt;b&gt;L3 API gateway :3003&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;JWT (Okta RS256) · per-user rate limit · depth/cost · persisted queries&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="835" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n6" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;L4 East-west firewall&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Istio mTLS STRICT · AuthorizationPolicy · NetworkPolicy default-deny&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n7" value='&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;wallet :3001 · transaction :3002 · ozzo :3004 · yone :3005&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1365" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n8" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;L5 Data firewall&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;SGs referencing SGs-for-Pods · NACL on isolated subnets · TLS required&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n9" value='&lt;b&gt;Data stores&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Atlas (PrivateLink) · RDS · ElastiCache&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1895" y="95" width="235" height="90" as="geometry"/></mxCell><mxCell id="3 n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n2" target="3 n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n3" target="3 n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n4" target="3 n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n5" target="3 n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n6" target="3 n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n7" target="3 n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n8" target="3 n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n17" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;L6 Egress firewall&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;app subnets 0.0.0.0/0 → AWS Network Firewall (TLS SNI / FQDN allowlist) + Route 53 Resolver DNS Firewall (block-all except allowlist) → NAT GW → IGW&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="215" width="500" height="70" as="geometry"/></mxCell><mxCell id="3 n18" value='&lt;b&gt;Internet SaaS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Okta · SendGrid · Twilio · Slack · Teams · New Relic · BTC provider&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1650" y="215" width="400" height="70" as="geometry"/></mxCell><mxCell id="3 n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;dashed=1;dashPattern=4 2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.764;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n7" target="3 n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n20" value="443 only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;dashed=1;dashPattern=4 2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 n17" target="3 n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 n21" value='&lt;span style="font-size:10px"&gt;There is no public ALB, no public node, no public DB and no bastion: operator access to EKS is via the private API endpoint over SSM Session Manager / Client VPN; port 22/3389 never open.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="1030" height="45" as="geometry"/></mxCell><mxCell id="3 n22" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Table 1 — L1 Edge: CloudFront + AWS WAF WebACL (attached to CloudFront)&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;#&lt;/th&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;Rule&lt;/th&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;Action&lt;/th&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;Notes&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;1&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;AWSManagedRulesAmazonIpReputationList&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Block&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;botnets, known bad IPs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;AWSManagedRulesCommonRuleSet (CRS)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Block&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;SizeRestrictions_BODY overridden to 64 KB for /graphql&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;AWSManagedRulesKnownBadInputsRuleSet&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Block&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Log4Shell, SSRF patterns&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;4&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Rate-based: 2000 req / 5 min / IP on /graphql&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Block (429)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;app also limits per user (sub)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;5&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Rate-based: 100 req / 5 min / IP on mutation sendTransaction (body match)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Challenge/Block&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;coarse; fine-grained in gateway&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;6&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Geo match not in {CA, US}&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Block&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;assumption — adjust to market&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;7&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Method not in {GET, POST, OPTIONS}&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Block&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;WS upgrade = GET&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;8&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Bot Control (common)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Count → Block&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;optional, cost-gated&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TLS policy TLSv1.2_2021 · HSTS · security headers policy (CSP from web-spa nginx)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Shield Standard (L3/L4) always on&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1030" height="300" as="geometry"/></mxCell><mxCell id="3 n23" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Table 2 — L2/L5 Security groups (stateful; all egress restricted, not 0.0.0.0/0 unless noted)&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;SG&lt;/th&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;Inbound&lt;/th&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;Source&lt;/th&gt;&lt;th style="background:#b85450;color:#ffffff;padding:3px;text-align:left"&gt;Outbound&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-alb&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;CloudFront VPC-origins service SG&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 3003 → sg-pod-gateway&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-pod-gateway&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 3003&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-alb&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3001/3002/3004 → sg-nodes · 443 → sg-vpce&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-nodes&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;mesh ports (15008 HBONE), app ports&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-nodes, sg-alb&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;via NFW route only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-pod-zuma&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 1024-65535 → sg-atlas-pl · 6379 → sg-redis&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-pod-ozzo&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 5432 → sg-rds-proxy · 6379 → sg-redis&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-pod-yone&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;6379 → sg-redis · 443 → NFW (SaaS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-atlas-pl&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 1024-65535&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-pod-zuma only&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-rds-proxy&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 5432&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-pod-ozzo&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;5432 → sg-rds&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-rds&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 5432&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-rds-proxy only&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-redis&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 6379&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-pod-zuma, sg-pod-ozzo, sg-pod-yone&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;sg-vpce&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TCP 443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;private app subnets&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="1100" y="310" width="1060" height="330" as="geometry"/></mxCell><mxCell id="3 n24" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Table 3 — L4 East-west authorization matrix (Istio AuthorizationPolicy + NetworkPolicy; everything not listed is DENIED)&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#56517e;color:#ffffff;padding:3px;text-align:left"&gt;Source identity (SA)&lt;/th&gt;&lt;th style="background:#56517e;color:#ffffff;padding:3px;text-align:left"&gt;Destination&lt;/th&gt;&lt;th style="background:#56517e;color:#ffffff;padding:3px;text-align:left"&gt;Port&lt;/th&gt;&lt;th style="background:#56517e;color:#ffffff;padding:3px;text-align:left"&gt;Allowed paths / methods&lt;/th&gt;&lt;th style="background:#56517e;color:#ffffff;padding:3px;text-align:left"&gt;App-layer auth&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ingress (ALB, outside mesh)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;graphql-gateway&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3003&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;POST /graphql, GET /graphql (WS), GET /healthz,/readyz&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;user JWT (Okta)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;zuma/graphql-gateway&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;wallet-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3001&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;/wallets/** (not /internal/**)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;user JWT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;zuma/graphql-gateway&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;transaction-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3002&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;/transactions/**&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;user JWT + Idempotency-Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;zuma/graphql-gateway&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ozzo-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3004&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;/users/**, /accounts/**, /wallets&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;user JWT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;zuma/transaction-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;wallet-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3001&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;POST /internal/wallets/*/debits|credits, GET /wallets/*&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;x-service-token (sub=transaction-service)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;zuma/wallet-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;transaction-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3002&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;GET /transactions?walletId&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;x-service-token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ozzo/ozzo-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;wallet-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3001&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;GET /wallets ONLY — never /internal/**&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;x-service-token (sub=ozzo)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;zuma/*, ozzo/* (optional sync path)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone-api&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3005&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;POST /api/v1/notifications/*&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;x-service-token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;observability/otel-agent&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;all pods&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;metrics port&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;GET /metrics&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;METRICS_TOKEN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;all workloads&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;observability/otel-collector&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;4317/4318&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;OTLP&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;mTLS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;kubelet&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;all pods&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;app port&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;/healthz, /readyz&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;none (probe)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1030" height="370" as="geometry"/></mxCell><mxCell id="3 n25" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Table 4 — L6 Egress allowlist (Network Firewall stateful domain list, TLS SNI; DNS Firewall mirrors it)&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#6c8ebf;color:#ffffff;padding:3px;text-align:left"&gt;Workload&lt;/th&gt;&lt;th style="background:#6c8ebf;color:#ffffff;padding:3px;text-align:left"&gt;FQDN&lt;/th&gt;&lt;th style="background:#6c8ebf;color:#ffffff;padding:3px;text-align:left"&gt;Port&lt;/th&gt;&lt;th style="background:#6c8ebf;color:#ffffff;padding:3px;text-align:left"&gt;Why&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone-worker, yone-api&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;api.sendgrid.com&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;email&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone-worker, yone-api&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;api.twilio.com&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;SMS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone-worker, yone-api&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;hooks.slack.com&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Slack webhooks&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone-worker, yone-api&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;*.logic.azure.com, *.webhook.office.com, *.api.powerplatform.com&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Teams Workflows&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;gateway, wallet, tx, ozzo&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;&amp;lt;tenant&amp;gt;.okta.com&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;OIDC discovery + JWKS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;otel-collector, fluent-bit&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;otlp.nr-data.net, log-api.newrelic.com&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;telemetry&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ozzo, yone (if NR agent kept)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;collector.newrelic.com&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;NR agent (until OTel-only)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;transaction-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;&amp;lt;btc-provider&amp;gt;&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;future broadcast RPC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;all&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;AWS APIs&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;VPC endpoints — never via NAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;*&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;anything else&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;*&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;DROP + alert&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="1100" y="670" width="1060" height="340" as="geometry"/></mxCell><mxCell id="3 n26" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Table 5 — Subnet NACLs &amp;amp; route tables&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#d6b656;color:#ffffff;padding:3px;text-align:left"&gt;Subnet tier&lt;/th&gt;&lt;th style="background:#d6b656;color:#ffffff;padding:3px;text-align:left"&gt;Route 0.0.0.0/0&lt;/th&gt;&lt;th style="background:#d6b656;color:#ffffff;padding:3px;text-align:left"&gt;NACL inbound&lt;/th&gt;&lt;th style="background:#d6b656;color:#ffffff;padding:3px;text-align:left"&gt;NACL outbound&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;public&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;IGW&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443 + ephemeral from 0.0.0.0/0 (NAT return)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;all&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;firewall&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;NAT GW (same AZ)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;from app subnets&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;all&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;private ingress&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;none&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;443 from CloudFront VPC origin ENIs (VPC CIDR)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3003 + ephemeral → app&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;private app&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;NFW endpoint (same AZ)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;from ingress + app subnets&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;to data, vpce, NFW&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;isolated data&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;&lt;b&gt;none&lt;/b&gt;&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;5432/6379/1024-65535 from app subnets only&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ephemeral → app only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;public RT return&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;app CIDRs → NFW endpoint&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;symmetric routing through firewall&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="1030" height="230" as="geometry"/></mxCell><mxCell id="3 n27" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Table 6 — DNS, CDN &amp;amp; TLS&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#9673a6;color:#ffffff;padding:3px;text-align:left"&gt;Item&lt;/th&gt;&lt;th style="background:#9673a6;color:#ffffff;padding:3px;text-align:left"&gt;Setting&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Public zone&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;app.zhios.example, api.zhios.example → CloudFront alias · DNSSEC signing · CAA records&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Private zone&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;*.svc.cluster.local inside EKS; Atlas PrivateLink and RDS endpoints via VPC DNS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Resolver DNS Firewall&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;allow-list domains in Table 4 + AWS; block everything else (stops DNS exfil)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;CloudFront&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;/ → S3 (SPA), /graphql → VPC origin (internal ALB); caching disabled for /graphql; origin request policy forwards Authorization; WebSocket on&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;TLS&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Edge TLSv1.2_2021 · ALB ELBSecurityPolicy-TLS13-1-2-2021-06 · mesh mTLS (Istio, auto-rotated) · DB/Redis TLS required (rds.force_ssl=1, Atlas TLS, ElastiCache in-transit)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Certificates&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ACM (edge us-east-1, ALB ca-central-1) · cert-manager only for in-cluster webhooks&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="1100" y="1035" width="1060" height="230" as="geometry"/></mxCell><mxCell id="3 n28" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Table 7 — Token model (application-layer identity on top of mesh identity)&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;Token&lt;/th&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;Today (repo)&lt;/th&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;Target&lt;/th&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;Risk addressed&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;User access token&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Okta / mock-oidc RS256 via JWKS (zuma, ozzo)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Okta RS256, aud zhios-api, 10 min TTL, refresh rotation; verified at gateway AND each service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;token replay, confused deputy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;x-service-token (zuma, ozzo)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;HS256, ONE shared INTERNAL_JWT_SECRET; sub is self-asserted&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;per-service asymmetric keys (ES256, KMS-backed) + verifier pins sub → key; plus Istio principal check&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;&lt;b&gt;HIGH:&lt;/b&gt; ozzo (or any holder) can mint sub=transaction-service and call /internal debits&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone ALLOWED_SERVICE_TOKENS&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;static shared bearer strings, no expiry, no caller identity&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;same signed service-token scheme as zuma + Istio AuthorizationPolicy&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;token leak = permanent send capability&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Slack/Teams webhook URLs&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;config only, named targets, host pinning (good)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;stored in Secrets Manager, rotated&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;SSRF / spam&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="2120" height="230" as="geometry"/></mxCell><mxCell id="3 n29" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;strokeWidth=2;strokeColor=#424242;fillColor=#ffffff;fontColor=#424242;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="1545" width="2120" height="182" as="geometry"/></mxCell><mxCell id="3 n30" value="Client (gnee)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="55" y="1580" width="135" height="32" as="geometry"/></mxCell><mxCell id="3 n31" value="Edge / API gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="205" y="1580" width="135" height="32" as="geometry"/></mxCell><mxCell id="3 n32" value="Security / firewall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="355