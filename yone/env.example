# yone observability settings. Copy values into your shell or yone.op.env; never commit real keys.

# --- New Relic APM ---
NEW_RELIC_ENABLED=false            # true starts the agent; requires NEW_RELIC_LICENSE_KEY
NEW_RELIC_LICENSE_KEY=             # secret: inject via 1Password (op run), never commit
NEW_RELIC_APP_NAME=yone-service
NEW_RELIC_LOG_LEVEL=info           # agent's own log level

# --- Logging ---
LOG_LEVEL=info                     # fatal|error|warn|info|debug|trace
LOG_TO_FILE=false                  # default: false in development, true in production when unset
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10485760         # bytes per file before rotation (10 MiB)
LOG_FILE_ROTATE_DAYS=7             # rotated files kept
NEWRELIC_LOGS_ENABLED=false        # ship logs to New Relic Logs API (needs NEW_RELIC_LICENSE_KEY)
NEWRELIC_LOGS_ENDPOINT=https://log-api.newrelic.com/log/v1
