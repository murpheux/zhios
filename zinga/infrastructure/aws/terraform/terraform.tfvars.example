# AWS Region for RDS deployment
aws_region = "ca-central-1"

# Deployment environment (development, staging, production)
environment = "development"

# RDS Cluster Configuration
cluster_identifier       = "zinga-postgres"
database_name           = "zinga_wallet"
master_username         = "zinga_admin"
db_instance_class       = "db.t4g.medium"
db_cluster_instance_count = 2
engine_version          = "16.1"

# Backup Configuration
backup_retention_period      = 30
preferred_backup_window      = "03:00-04:00"
preferred_maintenance_window = "sun:04:00-sun:05:00"

# Snapshot Configuration
skip_final_snapshot = true

# Monitoring & Logging
enable_cloudwatch_logs = true
enable_monitoring      = true
monitoring_interval    = 60

# Security
enable_iam_db_authentication = true
storage_encrypted           = true
publicly_accessible         = false
enable_deletion_protection  = false

# Network (optional; uses default VPC if not specified)
vpc_id = null

# Security Groups (optional)
allowed_security_group_ids = []
allowed_cidr_blocks        = []

# Additional Tags
tags = {
  Owner       = "zhios-team"
  CostCenter  = "platform"
}

# ============================================================================
# Usage Instructions
# ============================================================================
# 1. Copy this file to terraform.tfvars:
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. Edit terraform.tfvars with your specific values
#
# 3. Initialize Terraform:
#    terraform init
#
# 4. Review the plan:
#    terraform plan -out=tfplan
#
# 5. Apply the configuration:
#    terraform apply tfplan
#
# 6. Retrieve outputs:
#    terraform output -json > rds-outputs.json
#
# 7. Extract DATABASE_URL from Secrets Manager:
#    aws secretsmanager get-secret-value \
#      --secret-id $(terraform output -raw db_password_secret_id) \
#      --query SecretString --output text
#
# 8. Set environment variable for wallet-service:
#    export DATABASE_URL="postgresql://zinga_admin:<password>@$(terraform output -raw rds_endpoint):5432/zinga_wallet?sslmode=require"
