alEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r27" target="4 r28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r28" target="4 r29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r29" target="4 r30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r30" target="4 r31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r39" value='&lt;span style="font-size:10px"&gt;Synchronous response returns after ④ with status &lt;i&gt;pending/broadcasting&lt;/i&gt;; clients get later states through a GraphQL subscription (WSS) or polling. Notifications are best-effort at-least-once with dedupe; a failed notification NEVER fails or rolls back a transaction.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="1100" width="2080" height="40" as="geometry"/></mxCell><mxCell id="4 r40" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;strokeWidth=2;strokeColor=#424242;fillColor=#ffffff;fontColor=#424242;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="2120" height="182" as="geometry"/></mxCell><mxCell id="4 r41" value="Client (gnee)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="55" y="1255" width="135" height="32" as="geometry"/></mxCell><mxCell id="4 r42" value="Edge / API gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="205" y="1255" width="135" height="32" as="geometry"/></mxCell><mxCell id="4 r43" value="Security / firewall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="355" y="1255" width="135" height="32" as="geometry"/></mxCell><mxCell id="4 r44" value="Microservice" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="505" y="1255" width="135" height="32" as="geometry"/></mxCell><mxCell id="4 r45" value="Messaging / events" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="655" y="1255" width="135" height="32" as="geometry"/></mxCell><mxCell id="4 r46" value="Data store" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometr