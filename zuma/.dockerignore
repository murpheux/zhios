# Keep the build context minimal and secret-free (context = zuma/ root).
node_modules
**/node_modules
dist
**/dist
coverage
**/coverage
*.tsbuildinfo
**/*.tsbuildinfo
.git
.github
# Never ship env files (including .env.example — the images don't need it)
.env
.env.*
**/.env
**/.env.*
*.log
.vscode
.idea
.devcontainer
**/.devcontainer
infrastructure
scripts
docs
**/tests
**/*.test.ts
*.md
**/*.md
docker-compose*.yml
