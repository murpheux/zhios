# op:// REFERENCES only - safe to commit; never put values here. Resolve at run time:
#   op run --env-file=<this file> -- <command>
# (`op plugin run` only covers CLIs with a 1Password shell plugin; it does not resolve op:// refs.)
# Items in vault "zuma" (adjust vault/item names to your org). Use letters/digits only, >= 32 chars
# for secrets: the Mongo password is embedded in a MongoDB URI.
MONGO_ROOT_USERNAME=op://zuma/mongo-credentials/username
MONGO_ROOT_PASSWORD=op://zuma/mongo-credentials/password
JWT_SECRET=op://zuma/jwt-secrets/jwt_secret
INTERNAL_JWT_SECRET=op://zuma/jwt-secrets/internal_jwt_secret
METRICS_TOKEN=op://zuma/metrics/metrics_token
