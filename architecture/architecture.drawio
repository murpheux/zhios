eometry"/></mxCell><mxCell id="3 n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1590" as="sourcePoint"/><mxPoint x="900" y="1590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 n41" value="Synchronous request (HTTPS / HTTP/2, port)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1577" width="300" height="26" as="geometry"/></mxCell><mxCell id="3 n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1628" as="sourcePoint"/><mxPoint x="900" y="1628" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 n43" value="Asynchronous event (SNS / SQS)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1615" width="300" height="26" as="geometry"/></mxCell><mxCell id="3 n44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;dashPattern=10 3 2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1666" as="sourcePoint"/><mxPoint x="900" y="1666" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 n45" value="AuthN: OIDC / JWKS / token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1653" width="300" height="26" as="geometry"/></mxCell><mxCell id="3 n46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#0e8088;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1590" as="sourcePoint"/><mxPoint x="1290" y="1590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 n47" value="Telemetry: OTLP traces, metrics, logs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1577" width="300" height="26" as="geometry"/></mxCell><mxCell id="3 n48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;dashed=1;dashPattern=4 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1628" as="sourcePoint"/><mxPoint x="1290" y="1628" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 n49" value="Egress to Internet SaaS (via egress firewall)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1615" width="300" height="26" as="geometry"/></mxCell><mxCell id="3 n50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#996185;dashed=1;dashPattern=1 2;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1666" as="sourcePoint"/><mxPoint x="1290" y="1666" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 n51" value="Replication / backup / DR copy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1653" width="300" height="26" as="geometry"/></mxCell><mxCell id="3 n52" value='&lt;span style="font-size:10px"&gt;Numbers ①–⑨ trace the primary "send bitcoin" flow. Ports: gateway 3003 · wallet 3001 · transaction 3002 · ozzo 3004 · yone 3005 (moved from 3004) · Mongo 27017 · Postgres 5432 · Redis 6379 · OTLP 4317/4318.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="1685" width="2090" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4-resilience-deploy-dr" name="4 Resilience Deploy DR"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4 r1" value="zhios — Resilience, Deployment (blue/green) &amp;amp; Disaster Recovery" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2100" height="40" as="geometry"/></mxCell><mxCell id="4 r2" value='&lt;b&gt;GitHub PR&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;trunk / GitHub Flow · signed commits · ggshield&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r3" value='&lt;b&gt;GitHub Actions CI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;lint · typecheck · unit tests · build (zuma-ci.yml + gnee/ozzo/yone)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="305" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r4" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Image build&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Docker · Trivy (existing) · SBOM (syft) · cosign keyless sign&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r5" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Push ECR&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;GitHub OIDC → deploy role (no static keys) · immutable tag = git SHA&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="835" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r6" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;GitOps bump&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;PR to env/prod overlay (Kustomize/Helm) · required review&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r7" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Argo CD sync&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;pre-sync Job: Prisma migrate (expand only) / Mongo index job&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#e6d0de;strokeColor=#996185;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1365" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r8" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Argo Rollouts blue/green&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;preview Service → AnalysisTemplate (New Relic: 5xx &amp;lt; 1 %, p95 &amp;lt; 300 ms, 10 min) → promote active Service&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1630" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r9" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Rollback&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;auto-abort on failed analysis · scaleDownDelay 30 min keeps blue warm · contract migration only in a later release&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1895" y="70" width="240" height="110" as="geometry"/></mxCell><mxCell id="4 r10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r2" target="4 r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r3" target="4 r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r4" target="4 r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r5" target="4 r6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r6" target="4 r7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r7" target="4 r8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 r8" target="4 r9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 r17" value='&lt;span style="font-size:10px"&gt;Admission: Kyverno verifies cosign signatures from the zhios GitHub OIDC identity; pods must run non-root, read-only rootfs, no privilege escalation (matches existing compose hardening). Blue/green for the gateway (client-facing, instant switch); canary with the same analysis for wallet/transaction/ozzo; yone-worker rolling (queue absorbs).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="2100" height="45" as="geometry"/></mxCell><mxCell id="4 r18" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Resilience policy per call path (implemented in Istio waypoint + app clients; retries ONLY where the callee is idempotent)&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Caller → callee&lt;/th&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Timeout&lt;/th&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Retries&lt;/th&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Circuit breaker / outlier detection&lt;/th&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Idempotency / fallback&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;client → gateway&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;15 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;queries: 2 w/ jitter; mutations only with same Idempotency-Key&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;api-client reuses key per review session&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;gateway → wallet (GET)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2, on connect-failure/503, retry budget 20 %&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;5 consecutive 5xx → eject 30 s, max 50 % ejected&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;partial GraphQL result + error&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;gateway → transaction (POST)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;5 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;1 (safe: Idempotency-Key)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;same&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;dedupe on key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;transaction → wallet /internal debit|credit&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3, exp backoff 100 ms→1 s + jitter&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;same&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ledger idempotent on transactionId; refund on failed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;wallet → transaction (history)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;1&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;open → degraded&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;wallet without history&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ozzo → wallet&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;open → serve stale cache&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;stale-while-revalidate (Redis)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone → SendGrid/Twilio/Slack/Teams&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;5 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;&lt;b&gt;none in-process&lt;/b&gt;; SQS redelivery (visibility backoff), maxReceive 5 → DLQ&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;per-provider breaker (cockatiel/opossum)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;dedupe key notif:{eventId}:{channel}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;services → Mongo / PG / Redis&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;driver timeouts · bounded pools&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;driver retryable writes (Mongo)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;@fastify/under-pressure → 503 load shed&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;RDS Proxy absorbs failover&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;outbox relay → SNS&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2 s&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;unbounded w/ backoff&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;event id = outbox _id; consumers dedupe&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="1300" height="360" as="geometry"/></mxCell><mxCell id="4 r19" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Auto-scaling&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Workload&lt;/th&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Min/Max&lt;/th&gt;&lt;th style="background:#82b366;color:#ffffff;padding:3px;text-align:left"&gt;Signal&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;graphql-gateway&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3 / 20&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;HPA CPU 60 % + RPS per pod (custom metric)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;wallet, transaction&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3 / 15&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;HPA CPU 60 %&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ozzo-service&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3 / 10&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;HPA CPU 60 %&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;outbox-relay&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2 / 2&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;leader election (Lease)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone-api&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;2 / 6&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;HPA CPU&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;yone-worker&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;1 / 10&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;KEDA: SQS visible msgs, target 50/pod&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;nodes&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;3 system + elastic&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Karpenter, consolidation, Spot for tolerant pools&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;RDS / Valkey / Atlas&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;vertical&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;storage autoscaling · Atlas cluster tier auto-scale&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="1370" y="255" width="790" height="300" as="geometry"/></mxCell><mxCell id="4 r20" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Backup &amp;amp; disaster recovery (targets are assumptions — confirm with business)&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;Component&lt;/th&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;Backup / replication&lt;/th&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;RPO&lt;/th&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;RTO&lt;/th&gt;&lt;th style="background:#996185;color:#ffffff;padding:3px;text-align:left"&gt;Failover&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;MongoDB Atlas (ledger)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;continuous backup + PITR · snapshot copy to ca-west-1 (or 5-node RS 2+2+1)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;≤ 1 min (AZ) / ≤ 5 min (region)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;≤ 1 h&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;restore or elect in ca-west-1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;RDS PostgreSQL&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Multi-AZ sync · 35-day PITR · AWS Backup vault lock · cross-region read replica&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;0 (AZ) / &amp;lt; 5 min&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;≤ 2 min (AZ) / ≤ 30 min&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;promote replica&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ElastiCache Valkey&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Multi-AZ replica · daily snapshot&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;n/a (cache)&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;≤ 1 min&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;auto; cold cache acceptable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;SNS / SQS&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;regional multi-AZ · DLQ 14 days&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;in-flight only&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;≤ 1 h&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;outbox retained 7 days → replay&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;EKS workloads&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;stateless · GitOps · ECR replicated&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;≤ 1 h&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Argo CD sync to DR cluster&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Secrets&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Secrets Manager replica secrets&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;0&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;minutes&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;ESO points at DR region&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Logs&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;S3 Object Lock + CRR · NR retention&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;≤ 15 min&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;n/a&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1300" height="260" as="geometry"/></mxCell><mxCell id="4 r21" value='&lt;span style="font-size:10px"&gt;&lt;b&gt;Exercises:&lt;/b&gt; monthly automated restore test of Atlas + RDS into a scratch account (verify ledger balance checksums) · quarterly AZ-failure chaos test (AWS FIS) · semi-annual region failover game day with runbook timing.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="1300" height="40" as="geometry"/></mxCell><mxCell id="4 r22" value='&lt;div style="font-size:12px;font-weight:bold;padding:4px"&gt;Observability &amp;amp; alerting&lt;/div&gt;&lt;table border="1" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:10px"&gt;&lt;tr&gt;&lt;th style="background:#0e8088;color:#ffffff;padding:3px;text-align:left"&gt;Signal&lt;/th&gt;&lt;th style="background:#0e8088;color:#ffffff;padding:3px;text-align:left"&gt;Source → sink&lt;/th&gt;&lt;th style="background:#0e8088;color:#ffffff;padding:3px;text-align:left"&gt;Alert&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Traces&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;OTel SDK (zuma today) / NR agent (ozzo, yone) → Collector → NR&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;p95 latency SLO burn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Metrics&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Fastify metrics + OTel → NR · CloudWatch (ALB, WAF, NFW, RDS) via metric streams&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;5xx rate, saturation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Logs&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;pino JSON stdout → Fluent Bit → NR Logs + S3&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;error spikes, auth failures&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Business&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;tx broadcast success, refunds, ledger mismatch job&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;any mismatch = SEV1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Queues&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;SQS age of oldest msg, DLQ depth&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;DLQ &amp;gt; 0, age &amp;gt; 5 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Security&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;GuardDuty (EKS runtime), WAF blocks, NFW drops, CloudTrail&lt;/td&gt;&lt;td style="padding:3px;vertical-align:top"&gt;Security Hub → on-call&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;spacing=2;" vertex="1" parent="1"><mxGeometry x="1370" y="580" width="790" height="320" as="geometry"/></mxCell><mxCell id="4 r23" value="Primary flow — send bitcoin (sync path + async notification)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;strokeWidth=2;strokeColor=#424242;fillColor=#ffffff;fontColor=#424242;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="2120" height="230" as="geometry"/></mxCell><mxCell id="4 r24" value='&lt;b&gt;① api-client&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;builds send; one Idempotency-Key per review session&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1005" width="235" height="80" as="geometry"/></mxCell><mxCell id="4 r25" value='&lt;b&gt;② gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;JWT · cost limit · persisted query → POST /transactions&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="322" y="1005" width="235" height="80" as="geometry"/></mxCell><mxCell id="4 r26" value='&lt;b&gt;③ transaction-service&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;dedupe key · create pending&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="584" y="1005" width="235" height="80" as="geometry"/></mxCell><mxCell id="4 r27" value='&lt;b&gt;④ wallet /internal debit&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;guarded atomic debit + ledger entry&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="846" y="1005" width="235" height="80" as="geometry"/></mxCell><mxCell id="4 r28" value='&lt;b&gt;⑤ broadcast&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Bitcoin node · status → broadcast / failed (refund)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1108" y="1005" width="235" height="80" as="geometry"/></mxCell><mxCell id="4 r29" value='&lt;b&gt;⑥ outbox&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;tx + outbox doc in one Mongo txn&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="1005" width="235" height="80" as="geometry"/></mxCell><mxCell id="4 r30" value='&lt;b&gt;⑦ SNS → 