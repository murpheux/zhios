# Copy to .env (never commit). Values below are placeholders.
NODE_ENV=development
PORT=3004
LOG_LEVEL=info
POSTGRES_USER=ozzo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ozzo
DATABASE_URL=postgresql://ozzo:change-me@localhost:5432/ozzo?schema=public
REDIS_URL=redis://localhost:6379
OKTA_ISSUER_BASE_URL=https://your-org.okta.com/oauth2/default
OKTA_AUDIENCE=api://default
ADMIN_GROUP=ozzo-admin
WALLET_SERVICE_URL=http://localhost:3001
WALLET_SERVICE_NAME=wallet-service
# Must equal zuma INTERNAL_JWT_SECRET (>=32 chars); leave empty to skip x-service-token
INTERNAL_JWT_SECRET=
INTERNAL_JWT_ISSUER=ozzo
USE_MOCK_ZUMA=false
CACHE_TTL_SECONDS=300

# New Relic APM (license key required when NEW_RELIC_ENABLED or NEWRELIC_LOGS_ENABLED is true; inject via secret manager, never commit)
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=ozzo-service
NEW_RELIC_LOG_LEVEL=info

# Pino Logging (LOG_LEVEL is set above; LOG_TO_FILE defaults to true when NODE_ENV=production, else false)
LOG_TO_FILE=false
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_ROTATE_DAYS=7
NEWRELIC_LOGS_ENABLED=false
NEWRELIC_LOGS_ENDPOINT=https://log-api.newrelic.com/log/v1
