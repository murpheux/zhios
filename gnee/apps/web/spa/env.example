# Non-secret — plain values are fine here.
VITE_ZUMA_GATEWAY_URL=http://localhost:3003/graphql

# OIDC provider (Auth0 / Keycloak / Cognito / Azure AD / …). client_id is a public
# SPA client id (no client secret — Authorization Code + PKCE), but still varies
# per environment, so it's sourced from 1Password like the rest:
# run with `op run --env-file=env.example -- npm run dev` to resolve the op:// refs,
# or `op read op://<vault>/<item>/<field>` to print one value for manual use.
VITE_OIDC_AUTHORITY=op://zuma/web-spa-oidc/authority
VITE_OIDC_CLIENT_ID=op://zuma/web-spa-oidc/client_id
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
VITE_OIDC_SCOPE=openid profile email
# Only needed if your provider requires an explicit API audience/resource indicator.
VITE_OIDC_AUDIENCE=op://zuma/web-spa-oidc/audience

# New Relic Browser (https://one.newrelic.com -> Add data -> Browser monitoring -> Copy/paste, "NPM" option).
# These are browser ingest identifiers (shipped to every visitor by design), but the license key
# is still kept in 1Password for rotation. Off by default; enable per environment.
VITE_NEWRELIC_ENABLED=false
VITE_NEWRELIC_LICENSE_KEY=op://zuma/web-spa-newrelic/license_key
VITE_NEWRELIC_APP_ID=
VITE_NEWRELIC_ACCOUNT_ID=
VITE_NEWRELIC_AGENT_ID=
# Optional release/environment tags shown as custom attributes.
VITE_APP_VERSION=dev
VITE_APP_ENV=development
