=2;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1340" as="sourcePoint"/><mxPoint x="900" y="1340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1 l101" value="Synchronous request (HTTPS / HTTP/2, port)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1327" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 l102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1378" as="sourcePoint"/><mxPoint x="900" y="1378" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1 l103" value="Asynchronous event (SNS / SQS)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1365" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 l104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;dashPattern=10 3 2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1416" as="sourcePoint"/><mxPoint x="900" y="1416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1 l105" value="AuthN: OIDC / JWKS / token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="908" y="1403" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 l106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#0e8088;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1340" as="sourcePoint"/><mxPoint x="1290" y="1340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1 l107" value="Telemetry: OTLP traces, metrics, logs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1327" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 l108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6c8ebf;dashed=1;dashPattern=4 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1378" as="sourcePoint"/><mxPoint x="1290" y="1378" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1 l109" value="Egress to Internet SaaS (via egress firewall)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1365" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 l110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#996185;dashed=1;dashPattern=1 2;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1416" as="sourcePoint"/><mxPoint x="1290" y="1416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1 l111" value="Replication / backup / DR copy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1298" y="1403" width="300" height="26" as="geometry"/></mxCell><mxCell id="1 l112" value='&lt;span style="font-size:10px"&gt;Numbers ①–⑨ trace the primary "send bitcoin" flow. Ports: gateway 3003 · wallet 3001 · transaction 3002 · ozzo 3004 · yone 3005 (moved from 3004) · Mongo 27017 · Postgres 5432 · Redis 6379 · OTLP 4317/4318.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="1435" width="1530" height="36" as="geometry"/></mxCell><mxCell id="1 l113" value='&lt;span style="font-size:10px"&gt;&lt;b&gt;Secrets:&lt;/b&gt; every workload reads only its own secrets from Secrets Manager via External Secrets Operator (Pod Identity role per ServiceAccount). No secret in images, ConfigMaps, Terraform state or git.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1630" y="1295" width="540" height="60" as="geometry"/></mxCell><mxCell id="1 l114" value='&lt;span style="font-size:10px"&gt;&lt;b&gt;Flow ①–⑨ (send BTC):&lt;/b&gt; client → CloudFront/WAF → ALB → gateway → transaction-service (Idempotency-Key) → wallet debit (/internal, service token) → tx + outbox written atomically → relay publishes tx.broadcast → SQS → yone worker → SendGrid/Twilio.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1630" y="1360" width="540" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-physical-aws-deployment" name="2 Physical AWS Deployment"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 p1" value='zhios — Physical Deployment (AWS, ca-central-1 primary · ca-west-1 DR)&lt;br&gt;&lt;span style="font-size:12px;font-weight:normal"&gt;EKS + Istio ambient · 3 AZs · CloudFront VPC origin (no public ALB) · data tier in isolated subnets · VPC 10.40.0.0/16 (no overlap with home LAN 10.10.2.0/24)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2300" height="60" as="geometry"/></mxCell><mxCell id="2 p2" value='&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;gnee iOS / Android / Web&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="170" height="60" as="geometry"/></mxCell><mxCell id="2 p3" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;Route 53&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;public zone · DNSSEC · failover records&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#d0cee2;strokeColor=#56517e;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="85" width="190" height="60" as="geometry"/></mxCell><mxCell id="2 p4" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;CloudFront + AWS WAF + Shield Std&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;edge TLS (ACM us-east-1) · origin group: primary ca-central-1 → failover ca-west-1&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="330" height="70" as="geometry"/></mxCell><mxCell id="2 p5" value='&lt;font color="#0050ef"&gt;&lt;b&gt;[NEW] &lt;/b&gt;&lt;/font&gt;&lt;b&gt;S3 SPA bucket (OAC)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;SSE-KMS · versioned&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="85" width="190" height="60" as="geometry"/></mxCell><mxCell id="2 p6" value='&lt;b&gt;EAS Build / Submit&lt;/b&gt;&lt;br&