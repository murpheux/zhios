# Example terraform.tfvars for ozzo RDS PostgreSQL deployment
# Copy to terraform.tfvars and fill in actual values
# NEVER commit terraform.tfvars with real credentials; use environment variables instead:
#   export TF_VAR_db_username="ozzo_admin"
#   export TF_VAR_db_password="SecureP@ssw0rd123"

aws_region = "us-east-1"
environment = "dev"

# RDS PostgreSQL configuration
db_instance_class       = "db.t3.micro"        # dev: t3.micro, prod: t3.small or larger
db_name                 = "ozzo"               # Initial database name
db_storage_allocated_gb = 20                   # Starting storage (min 20 GB)
db_max_allocated_storage_gb = 100              # Auto-scale up to this (0 = no auto-scaling)
db_backup_retention_days = 7                   # Keep backups for 7 days (0-35)
db_multi_az             = false                # High availability (recommended for prod)
db_publicly_accessible  = false                # Keep private; access from K8s only
db_skip_final_snapshot  = true                 # Skip snapshot on destroy (set false for prod)
enable_cloudwatch_logs  = true                 # Export PostgreSQL logs to CloudWatch

# Security
# db_username and db_password MUST be set via environment variables:
#   export TF_VAR_db_username="ozzo_admin"
#   export TF_VAR_db_password="SecureP@ssw0rd123"
# Or pass on command line:
#   terraform apply -var='db_username=ozzo_admin' -var='db_password=SecureP@ssw0rd123'

# Optional: If deploying with EKS in the same Terraform stack
# eks_security_group_id = "sg-0123456789abcdef0"

# Optional: Allow specific security groups (in addition to EKS)
# allowed_security_group_ids = ["sg-0123456789abcdef0", "sg-abcdef0123456789"]

# Optional: Allow CIDR blocks (only if db_publicly_accessible = true)
# allowed_cidr_blocks = ["203.0.113.0/24"]

# Optional: Use customer-managed KMS key for encryption (production only)
# kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012"

# Additional tags
tags = {
  Team       = "Platform"
  CostCenter = "Engineering"
  Terraform  = "true"
}
