generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  checking
  savings
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  username       String        @unique
  email          String        @unique
  externalId     String        @unique @map("external_id") // Okta user id (JWT sub)

  // Authentication state
  isActive             Boolean   @default(true) @map("is_active")
  emailVerified        Boolean   @default(false) @map("email_verified")
  phoneVerified        Boolean   @default(false) @map("phone_verified")
  lastLoginAt          DateTime? @map("last_login_at")
  lastPasswordChangeAt DateTime? @map("last_password_change_at")
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")

  // Roles and permissions (stored as JSON arrays)
  roles       Json      @default("[]") @db.JsonB
  permissions Json      @default("[]") @db.JsonB

  // Nested profile objects (JSON structures)
  identity           Json  @default("{}") @db.JsonB // UserIdentity: displayName, firstName, lastName, dateOfBirth, sex, etc.
  contact            Json  @default("{}") @db.JsonB // UserContact: phoneNumber, mobileNumber, secondaryEmail
  address            Json? @db.JsonB // Address: street, city, country, etc.
  preferences        Json  @default("{}") @db.JsonB // UserPreferences: theme, locale, timeZone, notifications
  emergencyContacts  Json  @default("{}") @db.JsonB // UserEmergencyContacts: primaryContact, secondaryContact, nextOfKin
  employment         Json  @default("{}") @db.JsonB // UserEmployment: jobTitle, departmentId, etc.
  compliance         Json  @default("{}") @db.JsonB // UserCompliance: encryptedTaxId, termsAcceptedAt, etc.
  externalIds        Json  @default("{}") @db.JsonB // ExternalIds: okta, azureAd, google, etc.

  // Audit trail (separate JSON object)
  audit Json @default("{}") @db.JsonB // UserAudit: createdBy, updatedBy, deletedAt, isDeleted, etc.

  // Standard timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bankAccounts BankAccount[]

  @@map("users")
}

model BankAccount {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  accountNumber String      @unique @map("account_number")
  accountType   AccountType @map("account_type")
  balance       BigInt      @default(0) // integer cents/satoshis
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bank_accounts")
}
